<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#448B5CF6">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#262052" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#AA06B6D4" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#141B36" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#4D8B5CF6" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
