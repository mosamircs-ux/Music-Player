<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0C1021" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#6606B6D4"
                android:endColor="#228B5CF6"
                android:startColor="#228B5CF6"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
